  "type": "heading",
  "text": "1. Hotbar lines"
 },
 {
  "type": "line",
  "key": "Q",
  "name": "Prayer line",
  "skills_top_to_bottom": [
   "condemnation",
   "chain-of-torment",
   "earth-punishment",
   "prayer-of-amplification"
  ],
  "note": "Prayer whenever it is ready, then Earth Punishment and Chain of Torment, so every Condemnation crits and resets. Keep Light of Protection out of the line: it is a toggle, and every second press would switch it off."
 },
 {
  "type": "line",
  "key": "T",
  "name": "Divine Aura line",
  "skills_top_to_bottom": [
   "judgment-thunder",
   "divine-aura"
  ],
  "note": "The aura when it is ready, Judgment Thunder in between — after each Judgment Thunder Condemnation can crit and reset again."
 },
 {
  "type": "line",
  "key": "1",
  "name": "Debuff line",
  "skills_top_to_bottom": [
   "debilitating-mark",
   "lightning-strike-scattershot"
  ],
  "note": "Lightning Strike Scattershot on a staggered boss, otherwise Debilitating Mark — press it on cooldown."
 },
 {
  "type": "line",
  "key": "E",
  "name": "Heal line",
  "skills_top_to_bottom": [
   "healing-light",
   "light-of-regeneration"
  ],
  "note": "Light of Regeneration whenever it is ready, Healing Light (three charges) for the rest."
 },
 {
  "type": "heading",
